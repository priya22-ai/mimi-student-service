@model WebApplication1.Models.ViewModels.ServiceRequestDetailViewModel
@{
    ViewData["Title"] = "Request Details — Staff";
}

<div class="page-header" style="padding-top:0; margin-bottom:1.25rem;">
    <div>
        <div style="display:inline-block; background:var(--info-bg); border:1px solid #bfdbfe; color:var(--info); padding:0.2rem 0.6rem; border-radius:50px; font-size:0.68rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; margin-bottom:0.5rem;">Staff View</div>
        <h1 class="page-title" style="margin-bottom:0.25rem; font-size:1.6rem;">Request #@Model.Id</h1>
        <p style="margin:0; color:var(--text-muted); font-size:0.85rem;">Student: @Model.StudentName (@Model.StudentEmail) · Submitted @Model.CreatedDate.ToString("dd MMM yyyy")</p>
    </div>
    <div>
        @switch (Model.Status)
        {
            case WebApplication1.Models.RequestStatus.Pending:
                <span class="status-badge status-pending" style="font-size:0.8rem; padding:0.4em 0.9em;">Pending</span>
                break;
            case WebApplication1.Models.RequestStatus.Processing:
                <span class="status-badge status-processing" style="font-size:0.8rem; padding:0.4em 0.9em;">Processing</span>
                break;
            case WebApplication1.Models.RequestStatus.Completed:
                <span class="status-badge status-completed" style="font-size:0.8rem; padding:0.4em 0.9em;">Completed</span>
                break;
            case WebApplication1.Models.RequestStatus.Rejected:
                <span class="status-badge status-rejected" style="font-size:0.8rem; padding:0.4em 0.9em;">Rejected</span>
                break;
        }
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="detail-card">
            <div class="detail-header">
                <h5 class="mb-0">Student & request information</h5>
                <span style="font-size:0.72rem; color:var(--text-muted); border:1px solid var(--border); padding:0.25rem 0.6rem; border-radius:50px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase;">Ref #@Model.Id</span>
            </div>
            <div class="detail-body">
                <div class="detail-row">
                    <span class="detail-label">Student name</span>
                    <span class="detail-value fw-bold">@Model.StudentName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Student email</span>
                    <span class="detail-value"><a href="mailto:@Model.StudentEmail" style="font-weight:500;">@Model.StudentEmail</a></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Request type</span>
                    <span class="detail-value fw-bold">@Model.RequestType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Description</span>
                    <span class="detail-value">@Model.Description</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Submitted on</span>
                    <span class="detail-value">@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt") <span style="color:var(--text-muted);">· UTC</span></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Last updated</span>
                    <span class="detail-value">@Model.UpdatedDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                </div>
            </div>
        </div>

        <div class="detail-card mt-4">
            <div class="detail-header dark">
                <h5 class="mb-0">Update status</h5>
                <span style="font-size:0.72rem; opacity:0.7; border:1px solid rgba(255,255,255,0.2); padding:0.25rem 0.6rem; border-radius:50px;">Staff action</span>
            </div>
            <div style="padding:1.5rem;">
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 align-items-end">
                        <div class="col-md-7">
                            <label class="form-label">New status</label>
                            <select name="Status" class="form-select">
                                @foreach (var status in Enum.GetValues<WebApplication1.Models.RequestStatus>())
                                {
                                    <option value="@status" selected="@(status == Model.Status)">@status</option>
                                }
                            </select>
                            <div class="form-text" style="font-size:0.78rem; color:var(--text-light);">Status change will be visible to the student immediately.</div>
                        </div>
                        <div class="col-md-5">
                            <button type="submit" class="btn btn-primary-custom w-100" style="padding:0.65rem;">
                                Update Status →
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="AllRequests" class="btn btn-outline-custom">← Back to All Requests</a>
        </div>
    </div>
</div>
