@model WebApplication1.Models.ViewModels.ServiceRequestDetailViewModel
@{
    ViewData["Title"] = "Request Details";
}

<div class="page-header" style="padding-top:0; margin-bottom:1.25rem;">
    <div>
        <h1 class="page-title" style="margin-bottom:0.25rem; font-size:1.6rem;">Request #@Model.Id</h1>
        <p style="margin:0; color:var(--text-muted); font-size:0.85rem;">Submitted on @Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt") · Last updated @Model.UpdatedDate.ToString("dd MMMM yyyy")</p>
    </div>
    <div>
        @switch (Model.Status)
        {
            case WebApplication1.Models.RequestStatus.Pending:
                <span class="status-badge status-pending" style="font-size:0.8rem; padding:0.4em 0.9em;">Pending</span>
                break;
            case WebApplication1.Models.RequestStatus.Processing:
                <span class="status-badge status-processing" style="font-size:0.8rem; padding:0.4em 0.9em;">Processing</span>
                break;
            case WebApplication1.Models.RequestStatus.Completed:
                <span class="status-badge status-completed" style="font-size:0.8rem; padding:0.4em 0.9em;">Completed</span>
                break;
            case WebApplication1.Models.RequestStatus.Rejected:
                <span class="status-badge status-rejected" style="font-size:0.8rem; padding:0.4em 0.9em;">Rejected</span>
                break;
        }
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="detail-card">
            <div class="detail-header">
                <h5 class="mb-0">Request summary</h5>
                <span style="font-size:0.72rem; color:var(--text-muted); border:1px solid var(--border); padding:0.25rem 0.6rem; border-radius:50px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase;">Ref #@Model.Id</span>
            </div>
            <div class="detail-body">
                <div class="detail-row">
                    <span class="detail-label">Request type</span>
                    <span class="detail-value fw-bold">@Model.RequestType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Description</span>
                    <span class="detail-value">@Model.Description</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Submitted on</span>
                    <span class="detail-value">@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt") <span style="color:var(--text-muted);">· UTC</span></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Last updated</span>
                    <span class="detail-value">@Model.UpdatedDate.ToString("dd MMMM yyyy, hh:mm tt") <span style="color:var(--text-muted);">· Status: @Model.Status</span></span>
                </div>
            </div>
        </div>

        <div style="margin-top:1rem; padding:1rem 1.25rem; background:var(--bg-soft); border:1px solid var(--border); border-radius:4px; font-size:0.82rem; color:var(--text-muted); line-height:1.6; display:flex; gap:0.75rem; align-items:flex-start;">
            <span style="width:28px;height:28px;border-radius:50%;background:#fff;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">ℹ️</span>
            <span><strong style="color:var(--navy);">Need help?</strong> Contact IUBAT support at <a href="mailto:support@iubat.edu" style="font-weight:600;">support@iubat.edu</a> with your reference number for faster assistance.</span>
        </div>

        <div class="mt-4">
            <a asp-action="MyRequests" class="btn btn-outline-custom">← Back to My Requests</a>
        </div>
    </div>
</div>
