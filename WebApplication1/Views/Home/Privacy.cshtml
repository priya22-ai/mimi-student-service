@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-header">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p>Your privacy and data security are our priority.</p>
    </div>
</div>

<div class="detail-card">
    <div style="padding:2rem;">
        <h5 style="font-weight:700; color:var(--navy); margin-bottom:0.75rem;">Privacy commitment</h5>
        <p style="color:var(--text-secondary); line-height:1.7; font-size:0.95rem;">
            IUBAT Student Service Request System collects only the information necessary to process your service requests —
            including your name, email, request type and description. Data is stored securely and access is restricted to
            authorized staff members. Requests are retained for administrative and audit purposes in accordance with university policy.
        </p>
        <p style="color:var(--text-secondary); line-height:1.7; font-size:0.95rem; margin-bottom:0;">
            For questions about data handling, contact <a href="mailto:support@iubat.edu" style="font-weight:600;">support@iubat.edu</a>.
        </p>
    </div>
</div>
